<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>Verify Your Account – ShopVerse</title>
  </head>
  <body style="margin: 0; padding: 0; background-color: #0f0f13; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;">

    <!-- Wrapper -->
    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #0f0f13; padding: 40px 16px;">
      <tr>
        <td align="center">

          <!-- Email Card -->
          <table width="600" cellpadding="0" cellspacing="0" border="0" style="max-width: 600px; width: 100%; background: linear-gradient(145deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%); border-radius: 24px; overflow: hidden; box-shadow: 0 25px 60px rgba(0,0,0,0.5);">

            <!-- Top Gradient Banner -->
            <tr>
              <td style="background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #a855f7 100%); padding: 0; height: 6px; font-size: 0; line-height: 0;">&nbsp;</td>
            </tr>

            <!-- Header -->
            <tr>
              <td align="center" style="padding: 48px 48px 32px 48px;">
                <!-- Logo / Brand -->
                <table cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td align="center">
                      <div style="display: inline-block; background: linear-gradient(135deg, #6366f1, #a855f7); border-radius: 16px; padding: 12px 20px;">
                        <span style="font-size: 22px; font-weight: 800; color: #ffffff; letter-spacing: -0.5px; text-decoration: none;">
                          🛍️ ShopVerse
                        </span>
                      </div>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Shield / Icon -->
            <tr>
              <td align="center" style="padding: 0 48px 24px 48px;">
                <div style="width: 80px; height: 80px; background: linear-gradient(135deg, rgba(99,102,241,0.2), rgba(168,85,247,0.2)); border: 2px solid rgba(99,102,241,0.4); border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; margin: 0 auto;">
                  <span style="font-size: 36px; line-height: 80px; display: block;">🔐</span>
                </div>
              </td>
            </tr>

            <!-- Title & Greeting -->
            <tr>
              <td align="center" style="padding: 0 48px 12px 48px;">
                <h1 style="margin: 0; font-size: 30px; font-weight: 800; color: #ffffff; letter-spacing: -0.5px; line-height: 1.2;">
                  Verify Your Account
                </h1>
              </td>
            </tr>
            <tr>
              <td align="center" style="padding: 0 48px 32px 48px;">
                <p style="margin: 0; font-size: 16px; color: #94a3b8; line-height: 1.6;">
                  Hey <strong style="color: #c4b5fd;"><%- name %></strong>, welcome to ShopVerse! 🎉<br/>
                  Use the one-time code below to activate your account.
                </p>
              </td>
            </tr>

            <!-- Divider -->
            <tr>
              <td style="padding: 0 48px;">
                <div style="height: 1px; background: linear-gradient(90deg, transparent, rgba(99,102,241,0.4), transparent);"></div>
              </td>
            </tr>

            <!-- OTP Box -->
            <tr>
              <td align="center" style="padding: 40px 48px;">
                <table cellpadding="0" cellspacing="0" border="0" style="background: rgba(99,102,241,0.12); border: 2px solid rgba(99,102,241,0.35); border-radius: 16px; padding: 28px 48px;">
                  <tr>
                    <td align="center">
                      <p style="margin: 0 0 8px 0; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: #818cf8;">
                        Your Verification Code
                      </p>
                      <p style="margin: 0; font-size: 52px; font-weight: 800; letter-spacing: 12px; color: #ffffff; font-family: 'Courier New', Courier, monospace; text-shadow: 0 0 20px rgba(139,92,246,0.6);">
                        <%- otp %>
                      </p>
                      <p style="margin: 12px 0 0 0; font-size: 12px; color: #64748b;">
                        ⏱️ This code expires in <strong style="color: #f97316;">5 minutes</strong>
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Divider -->
            <tr>
              <td style="padding: 0 48px;">
                <div style="height: 1px; background: linear-gradient(90deg, transparent, rgba(99,102,241,0.4), transparent);"></div>
              </td>
            </tr>

            <!-- Security Notice -->
            <tr>
              <td style="padding: 28px 48px;">
                <table cellpadding="0" cellspacing="0" border="0" width="100%" style="background: rgba(239,68,68,0.08); border: 1px solid rgba(239,68,68,0.25); border-radius: 12px; padding: 16px 20px;">
                  <tr>
                    <td style="vertical-align: top; width: 24px; padding-right: 12px;">
                      <span style="font-size: 18px;">⚠️</span>
                    </td>
                    <td>
                      <p style="margin: 0; font-size: 13px; color: #fca5a5; line-height: 1.6;">
                        <strong>Security Notice:</strong> Never share this code with anyone. ShopVerse will never ask for your OTP via phone or email. If you did not request this, please ignore this email.
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Help Text -->
            <tr>
              <td align="center" style="padding: 0 48px 40px 48px;">
                <p style="margin: 0; font-size: 14px; color: #64748b; line-height: 1.7;">
                  Having trouble? Contact our support team at<br/>
                  <a href="mailto:support@shopverse.com" style="color: #818cf8; text-decoration: none; font-weight: 600;">support@shopverse.com</a>
                </p>
              </td>
            </tr>

            <!-- Bottom Gradient Banner -->
            <tr>
              <td style="background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #a855f7 100%); padding: 0; height: 4px; font-size: 0; line-height: 0;">&nbsp;</td>
            </tr>

            <!-- Footer -->
            <tr>
              <td align="center" style="padding: 28px 48px; background-color: rgba(0,0,0,0.2);">
                <p style="margin: 0 0 8px 0; font-size: 13px; color: #475569;">
                  © <%= new Date().getFullYear() %> ShopVerse. All rights reserved.
                </p>
                <p style="margin: 0; font-size: 12px; color: #334155;">
                  <a href="#" style="color: #6366f1; text-decoration: none;">Privacy Policy</a>
                  &nbsp;&bull;&nbsp;
                  <a href="#" style="color: #6366f1; text-decoration: none;">Terms of Service</a>
                  &nbsp;&bull;&nbsp;
                  <a href="#" style="color: #6366f1; text-decoration: none;">Unsubscribe</a>
                </p>
              </td>
            </tr>

          </table>
          <!-- /Email Card -->

        </td>
      </tr>
    </table>
    <!-- /Wrapper -->

  </body>
</html>
